    "opaque_id": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encrypted", "algorithm"],
      "properties": {
        "encrypted": {
          "type": "boolean"
        },
        "algorithm": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "encrypted": {
              "const": false
            },
            "algorithm": {
              "const": "none"
            }
          }
        },
        {
          "properties": {
            "encrypted": {
              "const": true
            },
            "algorithm": {
              "not": {
                "const": "none"
              }
            }
          }
        }
      ]
    },
