{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni-folio.local/contracts/backup-manifest.v11.schema.json",
  "title": "Omni-Folio Backup Manifest v11",
  "description": "CLI contract for a separately restored schema-v17 backup candidate. Legacy v5/schema-v8 or schema-v9, v6/schema-v10, v7/schema-v11 or schema-v12, v8/schema-v13, v9/schema-v14, and v10/schema-v15 artifacts are accepted only through an owned migrated copy. Schema validity never authorizes replacing the active DB: database, ledger snapshot, replayable order state, execution authority, risk reservations, paper execution authorizations, known-good broker snapshots, strategy-registry including paper operational evaluations, immutable paper-accounting sessions, closed paper bars and signal cutoffs, direct FX-observation, security-price-observation, and instrument-listing proofs must match and verification_receipt must be verified and eligible_for_activation before replacement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "schema_version", "created_at", "source_ledger_revision", "order_state_sha256", "order_count", "order_event_count", "execution_authority_sha256", "execution_authority_event_count", "risk_reservation_sha256", "risk_reservation_count", "broker_state_sha256", "broker_snapshot_count", "broker_reconciliation_count", "strategy_registry_sha256", "strategy_evidence_count", "strategy_selection_event_count", "paper_evaluation_event_count", "paper_accounting_state_sha256", "paper_accounting_session_count", "paper_market_bar_observation_count", "paper_signal_event_count", "paper_execution_authorization_count", "paper_capitalized_fill_count", "selected_strategy_result_sha256", "fx_observation_state_sha256", "fx_observation_count", "security_price_observation_state_sha256", "security_price_observation_count", "instrument_listing_state_sha256", "instrument_listing_event_count", "active_instrument_listing_count", "db_sha256", "size_bytes", "expected_snapshot_sha256", "encryption", "verification_receipt"],
  "properties": {
    "format_version": {
      "const": "omni-folio-backup.v11"
    },
    "schema_version": {
      "const": "omni-folio.sqlite.v17"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "source_ledger_revision": {
      "$ref": "#/$defs/opaque_id"
    },
    "order_state_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "order_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "order_event_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "execution_authority_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "execution_authority_event_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "risk_reservation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "risk_reservation_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "broker_state_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "broker_snapshot_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "broker_reconciliation_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "strategy_registry_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "strategy_evidence_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "strategy_selection_event_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "paper_evaluation_event_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "paper_accounting_state_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "paper_accounting_session_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "paper_market_bar_observation_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "paper_signal_event_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "paper_execution_authorization_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "paper_capitalized_fill_count": {
      "type": "integer",
      "minimum": 0
    },
    "selected_strategy_result_sha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "const": "no_strategy" }
      ]
    },
    "fx_observation_state_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "fx_observation_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "security_price_observation_state_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "security_price_observation_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "instrument_listing_state_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "instrument_listing_event_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "active_instrument_listing_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "db_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expected_snapshot_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "encryption": {
      "$ref": "#/$defs/encryption"
    },
    "verification_receipt": {
      "$ref": "#/$defs/verification_receipt"
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encrypted", "algorithm"],
      "properties": {
        "encrypted": {
          "type": "boolean"
        },
        "algorithm": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "encrypted": {
              "const": false
            },
            "algorithm": {
              "const": "none"
            }
          }
        },
        {
          "properties": {
            "encrypted": {
              "const": true
            },
            "algorithm": {
              "not": {
                "const": "none"
              }
            }
          }
        }
      ]
    },
    "verification_receipt": {
      "description": "Verification is performed against a separately restored candidate. Candidate database, ledger snapshot, order-state, known-good broker-state, strategy-registry, paper-accounting state, direct FX-observation, security-price-observation, and instrument-listing proofs must equal the manifest before active DB replacement.",
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "candidate_id", "verified_at", "status", "integrity_check", "golden_snapshot_check", "order_state_check", "broker_state_check", "strategy_registry_check", "fx_observation_check", "security_price_observation_check", "instrument_listing_check", "candidate_db_sha256", "candidate_snapshot_sha256", "candidate_order_state_sha256", "candidate_broker_state_sha256", "candidate_strategy_registry_sha256", "candidate_paper_accounting_state_sha256", "candidate_fx_observation_state_sha256", "candidate_security_price_observation_state_sha256", "candidate_instrument_listing_state_sha256", "eligible_for_activation", "errors"],
      "properties": {
        "receipt_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "candidate_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "verified_at": {
          "$ref": "#/$defs/timestamp"
        },
        "status": {
          "type": "string",
          "enum": ["verified", "rejected"]
        },
        "integrity_check": {
          "type": "string",
          "enum": ["ok", "failed"]
        },
        "golden_snapshot_check": {
          "type": "string",
          "enum": ["ok", "failed"]
        },
        "order_state_check": {
          "type": "string",
          "enum": ["ok", "failed"]
        },
        "broker_state_check": {
          "type": "string",
          "enum": ["ok", "failed"]
        },
        "strategy_registry_check": {
          "type": "string",
          "enum": ["ok", "failed"]
        },
        "fx_observation_check": {
          "type": "string",
          "enum": ["ok", "failed"]
        },
        "security_price_observation_check": {
          "type": "string",
          "enum": ["ok", "failed"]
        },
        "instrument_listing_check": {
          "type": "string",
          "enum": ["ok", "failed"]
        },
        "candidate_db_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_order_state_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_broker_state_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_strategy_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_paper_accounting_state_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_fx_observation_state_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_security_price_observation_state_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_instrument_listing_state_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "eligible_for_activation": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "verified"
            },
            "integrity_check": {
              "const": "ok"
            },
            "golden_snapshot_check": {
              "const": "ok"
            },
            "order_state_check": {
              "const": "ok"
            },
            "broker_state_check": {
              "const": "ok"
            },
            "strategy_registry_check": {
              "const": "ok"
            },
            "eligible_for_activation": {
              "const": true
            },
            "errors": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "rejected"
            },
            "eligible_for_activation": {
              "const": false
            },
            "errors": {
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
