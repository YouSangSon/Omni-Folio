{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline paper signal proposal; not execution authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "strategy_result_sha256", "strategy_parameter_sha256", "input_sha256", "symbol", "data_as_of", "signal", "target_quantity", "proposal_sha256"],
  "properties": {
    "schema_version": {"const": "paper-signal-proposal.v1"},
    "mode": {"const": "paper_proposal_only"},
    "strategy_result_sha256": {"$ref": "#/$defs/sha256"},
    "strategy_parameter_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "symbol": {"type": "string", "pattern": "^[0-9]{6}$"},
    "data_as_of": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "signal": {"enum": ["golden_cross", "death_cross", "none"]},
    "target_quantity": {"type": ["string", "null"]},
    "proposal_sha256": {"$ref": "#/$defs/sha256"}
  },
  "oneOf": [
    {"properties": {"signal": {"const": "golden_cross"}, "target_quantity": {"type": "string", "pattern": "^[1-9][0-9]{0,63}$"}}},
    {"properties": {"signal": {"const": "death_cross"}, "target_quantity": {"const": "0"}}},
    {"properties": {"signal": {"const": "none"}, "target_quantity": {"type": "null"}}}
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
