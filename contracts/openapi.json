{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni-Folio Core API",
    "version": "0.7.0",
    "description": "Minimal cross-runtime contract for trust status, CSV import, deterministic portfolio snapshots, explicitly labeled sample market data, sanitized ledger activity, stored broker reconciliation, and verified local order lifecycle reads. JSON decimals are canonical strings; IDs are opaque strings."
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Process is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadiness",
        "description": "Checks that the process can read the migrated database schema required to serve ledger requests.",
        "responses": {
          "200": {
            "description": "Database is reachable and schema version is supported.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Database is unavailable, unmigrated, or on an unsupported schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "not_ready": {
                    "value": {
                      "code": "not_ready",
                      "message": "service is not ready"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "operationId": "getStatus",
        "responses": {
          "200": {
            "description": "Current local-ledger validation state. This does not claim reconciliation with a broker. Phase A never enables live trading.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                },
                "examples": {
                  "first_launch": {
                    "value": {
                      "service": "omni-folio",
                      "live_enabled": false,
                      "mode": "local_import_only",
                      "trust_state": "never_verified",
                      "ledger_revision": "rev_0000000000",
                      "last_verified_at": null,
                      "issues": []
                    }
                  },
                  "verified": {
                    "value": {
                      "service": "omni-folio",
                      "live_enabled": false,
                      "mode": "local_import_only",
                      "trust_state": "verified",
                      "ledger_revision": "rev_0000000003",
                      "last_verified_at": "2026-08-23T03:05:00Z",
                      "issues": []
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/market-data/candles": {
      "get": {
        "operationId": "getMarketDataCandles",
        "description": "Returns explicitly configured local-fixture OHLCV data only. It never represents live or broker data. symbol and interval must each appear exactly once; unknown query parameters are rejected.",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "schema": {"type": "string", "minLength": 1}
          },
          {
            "name": "interval",
            "in": "query",
            "required": true,
            "schema": {"type": "string", "minLength": 1}
          }
        ],
        "responses": {
          "200": {
            "description": "Local sample bars. price_adjustment=unspecified, source=local_fixture, sample=true, and state=stale are contractual disclosures, not live-market freshness claims.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/LocalFixtureMarketDataCandles"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {
            "description": "The configured local fixture has no matching symbol and interval.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"},
                "examples": {
                  "market_data_not_found": {"value": {"code": "market_data_not_found", "message": "market data was not found"}}
                }
              }
            }
          },
          "500": {
            "description": "The configured market-data adapter violated the normalized-series contract.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"},
                "examples": {
                  "internal_error": {"value": {"code": "internal_error", "message": "internal server error"}}
                }
              }
            }
          },
          "503": {
            "description": "No market-data fixture was configured at service startup.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"},
                "examples": {
                  "market_data_unavailable": {"value": {"code": "market_data_unavailable", "message": "market data is unavailable"}}
                }
              }
            }
          }
        }
      }
    },
    "/v1/market-data/fx/latest": {
      "get": {
        "operationId": "getLatestDirectFXObservation",
        "description": "Returns one directly stored local-fixture FX observation at or before as_of. The direction is exact: rate is quote-currency units per one base-currency unit. No inverse, cross, interpolation, FX_EXCHANGE inference, valuation, or live-freshness claim is provided.",
        "parameters": [
          {"name": "source", "in": "query", "required": true, "schema": {"const": "local_fixture"}},
          {"name": "base_currency", "in": "query", "required": true, "schema": {"type": "string", "pattern": "^[A-Z]{3}$"}},
          {"name": "quote_currency", "in": "query", "required": true, "schema": {"type": "string", "pattern": "^[A-Z]{3}$"}},
          {"name": "as_of", "in": "query", "required": true, "schema": {"type": "string", "format": "date-time"}}
        ],
        "responses": {
          "200": {
            "description": "A directly observed local sample with stale/sample provenance.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LocalFixtureFXObservation"}}}
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {
            "description": "No eligible observation exists for the exact source, direction, and cutoff.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          },
          "500": {
            "description": "Stored observation state failed canonical validation.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
          }
        }
      }
    },
    "/v1/broker-reconciliation/latest": {
      "get": {
        "operationId": "getLatestBrokerReconciliation",
        "description": "Returns the latest stored Kiwoom KRX position-quantity reconciliation. This is historical evidence with freshness=unverified; it does not refresh the broker, represent current state, or reconcile cash, valuation, fees, orders, or executions. Account references, internal IDs, hashes, and the raw snapshot are never returned.",
        "responses": {
          "200": {
            "description": "Sanitized latest stored reconciliation bound to its ledger revision.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/BrokerReconciliation"}
              }
            }
          },
          "404": {
            "description": "No stored broker snapshot exists.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"},
                "examples": {
                  "broker_reconciliation_not_found": {"value": {"code": "broker_reconciliation_not_found", "message": "broker reconciliation was not found"}}
                }
              }
            }
          },
          "500": {
            "description": "The newest stored snapshot or reconciliation failed canonical hash, metadata, or completeness validation.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"},
                "examples": {
                  "internal_error": {"value": {"code": "internal_error", "message": "internal server error"}}
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders": {
      "get": {
        "operationId": "getLocalOrders",
        "description": "Replays the append-only local order log without calling a broker or verifying current broker state. The response excludes account, client-order, provider-order, execution, reservation, strategy-authority, and fencing identifiers. It is display-only and provides no submit, retry, cancel, or other mutation action.",
        "responses": {
          "200": {
            "description": "Newest-first local order lifecycle records, or an empty orders array when none exist.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/LocalOrderLog"}
              }
            }
          },
          "500": {
            "description": "A stored order intent or event failed canonical validation or replay.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"},
                "examples": {
                  "internal_error": {"value": {"code": "internal_error", "message": "internal server error"}}
                }
              }
            }
          }
        }
      }
    },
    "/v1/ledger/activities": {
      "get": {
        "operationId": "getLedgerActivities",
        "description": "Returns a replay-verified, newest-first page of sanitized local ledger events. This does not call or refresh a broker, prove current broker state, value the portfolio, or expose a mutation action. Internal event, source, account, instrument, receipt, correction-target, and sequence identifiers are omitted.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "minLength": 1, "maxLength": 1024},
            "description": "Opaque keyset cursor bound to the ledger revision of the first page. The current local profile may invalidate it on service restart."
          }
        ],
        "responses": {
          "200": {
            "description": "A complete local-ledger page, including an empty events array when no transactions exist.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/LedgerActivityPage"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "500": {
            "description": "The local ledger failed canonical validation or deterministic replay; no partial page is returned.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"},
                "examples": {
                  "internal_error": {"value": {"code": "internal_error", "message": "internal server error"}}
                }
              }
            }
          }
        }
      }
    },
    "/v1/imports/preview": {
      "post": {
        "operationId": "previewImport",
        "description": "Parses and validates raw CSV text without writing to the ledger. Rejects input over 1 MiB (1048576 bytes) or 10000 data rows. The preview fingerprint binds file hash, schema version, mapping version, and ledger revision.",
        "requestBody": {
          "required": true,
          "content": {
            "text/csv": {
              "x-max-bytes": 1048576,
              "x-max-rows": 10000,
              "schema": {
                "type": "string",
                "minLength": 1,
                "description": "UTF-8 CSV text, limited to 1048576 encoded bytes and 10000 data rows excluding the header."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Read-only row classification and totals.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportPreview"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/v1/imports/apply": {
      "post": {
        "operationId": "applyImport",
        "description": "Atomically applies an applicable preview. Repeating the same idempotency_key with the same payload returns the original receipt. Reusing that key with a different payload returns 409.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplyImportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Original or replayed atomic apply receipt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplyReceipt"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "description": "The idempotency key was already used with a different payload, or the preview ledger revision is stale.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "idempotency_conflict": {
                    "value": {
                      "code": "idempotency_conflict",
                      "message": "idempotency_key was already used with a different payload"
                    }
                  },
                  "stale_preview": {
                    "value": {
                      "code": "stale_preview",
                      "message": "ledger revision changed; create a new preview"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/portfolio/snapshot": {
      "get": {
        "operationId": "getPortfolioSnapshot",
        "responses": {
          "200": {
            "description": "Deterministic ledger snapshot. It does not claim live market valuation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioSnapshot"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Malformed or invalid input.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "OpaqueId": {
        "type": "string",
        "minLength": 1,
        "description": "Opaque identifier. Consumers must not parse or order it."
      },
      "Decimal": {
        "type": "string",
        "pattern": "^(?:0|-?(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9]))$",
        "description": "Canonical base-10 decimal string: no exponent, leading plus/zero, trailing fractional zero, or negative zero."
      },
      "OccurredAt": {
        "type": "string",
        "format": "date-time",
        "description": "When the economic event occurred at its source."
      },
      "ReceivedAt": {
        "type": "string",
        "format": "date-time",
        "description": "When Omni-Folio received the apply request; this is not the source event time or durable commit time."
      },
      "RecordedAt": {
        "type": "string",
        "format": "date-time",
        "description": "When Omni-Folio durably recorded the ledger mutation."
      },
      "LedgerActivityTimestamp": {
        "type": "string",
        "format": "date-time",
        "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{0,8}[1-9])?Z$",
        "description": "Canonical UTC RFC3339 timestamp used by the verified local ledger."
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "Status": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "live_enabled", "mode", "trust_state", "ledger_revision", "last_verified_at", "issues"],
        "properties": {
          "service": {
            "const": "omni-folio"
          },
          "live_enabled": {
            "const": false,
            "description": "Phase A is read/import only; live trading is disabled."
          },
          "mode": {
            "const": "local_import_only"
          },
          "trust_state": {
            "type": "string",
            "enum": ["never_verified", "verified", "stale", "partial", "error"],
            "description": "Validation state of the local imported ledger only; verified does not mean broker-reconciled."
          },
          "ledger_revision": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "last_verified_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Time of the last successful atomic import and local ledger-invariant validation. Null when trust_state is never_verified; never a broker-reconciliation timestamp."
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "MarketDataCandle": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "open", "high", "low", "close", "volume"],
        "properties": {
          "at": {"type": "string", "format": "date-time"},
          "open": {"$ref": "#/components/schemas/Decimal"},
          "high": {"$ref": "#/components/schemas/Decimal"},
          "low": {"$ref": "#/components/schemas/Decimal"},
          "close": {"$ref": "#/components/schemas/Decimal"},
          "volume": {"$ref": "#/components/schemas/Decimal"}
        }
      },
      "MarketDataCandles": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "venue", "timezone", "interval", "price_adjustment", "source", "sample", "state", "source_as_of", "fetched_at", "issues", "bars"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "venue": {"type": "string", "minLength": 1},
          "timezone": {"type": "string", "minLength": 1},
          "interval": {"type": "string", "minLength": 1},
          "price_adjustment": {"type": "string", "enum": ["unspecified", "provider_adjusted"]},
          "source": {"type": "string", "minLength": 1},
          "sample": {"type": "boolean"},
          "state": {"type": "string", "enum": ["empty", "partial", "stale", "success"]},
          "source_as_of": {"type": ["string", "null"], "format": "date-time"},
          "fetched_at": {"type": "string", "format": "date-time"},
          "issues": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/Error"}
          },
          "bars": {
            "type": "array",
            "maxItems": 500,
            "items": {"$ref": "#/components/schemas/MarketDataCandle"}
          }
        }
      },
      "LocalFixtureMarketDataCandles": {
        "allOf": [
          {"$ref": "#/components/schemas/MarketDataCandles"},
          {
            "type": "object",
            "properties": {
              "price_adjustment": {"const": "unspecified"},
              "source": {"const": "local_fixture"},
              "sample": {"const": true},
              "state": {"const": "stale"},
              "source_as_of": {"type": "string", "format": "date-time"},
              "issues": {"type": "array", "minItems": 1, "items": {"$ref": "#/components/schemas/Error"}},
              "bars": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/components/schemas/MarketDataCandle"}}
            }
          }
        ]
      },
      "LocalFixtureFXObservation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "source", "base_currency", "quote_currency", "rate", "observed_at", "fetched_at", "recorded_at", "sample", "state", "issues"],
        "properties": {
          "observation_id": {"$ref": "#/components/schemas/OpaqueId"},
          "source": {"const": "local_fixture"},
          "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "quote_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "rate": {"$ref": "#/components/schemas/Decimal", "description": "Exact quote-currency units per one base-currency unit."},
          "observed_at": {"type": "string", "format": "date-time"},
          "fetched_at": {"type": "string", "format": "date-time"},
          "recorded_at": {"type": "string", "format": "date-time"},
          "sample": {"const": true},
          "state": {"const": "stale"},
          "issues": {"type": "array", "minItems": 1, "items": {"$ref": "#/components/schemas/Error"}}
        }
      },
      "BrokerPositionDifference": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "broker_quantity", "ledger_quantity", "difference", "match"],
        "properties": {
          "symbol": {"type": "string", "pattern": "^[0-9]{6}$"},
          "broker_quantity": {"$ref": "#/components/schemas/Decimal", "description": "Canonical non-negative quantity from the stored broker snapshot."},
          "ledger_quantity": {"$ref": "#/components/schemas/Decimal", "description": "Canonical non-negative quantity replayed from the bound ledger revision."},
          "difference": {"$ref": "#/components/schemas/Decimal", "description": "broker_quantity minus ledger_quantity."},
          "match": {"type": "boolean", "description": "True exactly when difference is zero."}
        }
      },
      "BrokerReconciliation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "environment", "exchange", "freshness", "fetched_at", "recorded_at", "ledger_revision", "all_positions_match", "position_differences"],
        "properties": {
          "provider": {"const": "kiwoom"},
          "environment": {"type": "string", "enum": ["mock", "production"]},
          "exchange": {"const": "KRX"},
          "freshness": {"const": "unverified", "description": "The endpoint returns stored evidence and does not verify current broker state."},
          "fetched_at": {"type": "string", "format": "date-time"},
          "recorded_at": {"type": "string", "format": "date-time"},
          "ledger_revision": {"type": "string", "pattern": "^rev_[0-9]{10}$"},
          "all_positions_match": {"type": "boolean"},
          "position_differences": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/BrokerPositionDifference"}
          }
        }
      },
      "LedgerActivity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "occurred_at", "recorded_at", "symbol", "quantity", "price", "fee", "currency", "amount", "counter_currency", "counter_amount", "is_correction"],
        "properties": {
          "type": {"type": "string", "enum": ["BUY", "SELL", "DEPOSIT", "WITHDRAWAL", "DIVIDEND", "FEE", "TAX", "SPLIT", "CASH_VOID", "FX_EXCHANGE"]},
          "occurred_at": {"$ref": "#/components/schemas/LedgerActivityTimestamp"},
          "recorded_at": {"$ref": "#/components/schemas/LedgerActivityTimestamp"},
          "symbol": {"type": ["string", "null"], "minLength": 1},
          "quantity": {"anyOf": [{"$ref": "#/components/schemas/Decimal"}, {"type": "null"}]},
          "price": {"anyOf": [{"$ref": "#/components/schemas/Decimal"}, {"type": "null"}]},
          "fee": {"anyOf": [{"$ref": "#/components/schemas/Decimal"}, {"type": "null"}]},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "amount": {"$ref": "#/components/schemas/Decimal", "description": "Exact signed cash effect; this is not a base-currency valuation."},
          "counter_currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$", "description": "Non-null only for FX_EXCHANGE and always distinct from currency."},
          "counter_amount": {"anyOf": [{"$ref": "#/components/schemas/Decimal"}, {"type": "null"}], "description": "Positive exact bought amount for FX_EXCHANGE; it is not a quoted or current exchange rate."},
          "is_correction": {"type": "boolean", "description": "True only for CASH_VOID. The correction target identifier is intentionally omitted."}
        },
        "oneOf": [
          {
            "properties": {
              "type": {"const": "BUY"},
              "symbol": {"type": "string", "minLength": 1},
              "quantity": {"$ref": "#/components/schemas/Decimal"},
              "price": {"$ref": "#/components/schemas/Decimal"},
              "fee": {"$ref": "#/components/schemas/Decimal"},
              "amount": {"type": "string", "pattern": "^-(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"},
              "counter_currency": {"type": "null"},
              "counter_amount": {"type": "null"},
              "is_correction": {"const": false}
            }
          },
          {
            "properties": {
              "type": {"const": "SELL"},
              "symbol": {"type": "string", "minLength": 1},
              "quantity": {"$ref": "#/components/schemas/Decimal"},
              "price": {"$ref": "#/components/schemas/Decimal"},
              "fee": {"$ref": "#/components/schemas/Decimal"},
              "amount": {"type": "string", "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"},
              "counter_currency": {"type": "null"},
              "counter_amount": {"type": "null"},
              "is_correction": {"const": false}
            }
          },
          {
            "properties": {
              "type": {"const": "DIVIDEND"},
              "symbol": {"type": "string", "minLength": 1},
              "quantity": {"type": "null"},
              "price": {"type": "null"},
              "fee": {"type": "null"},
              "amount": {"type": "string", "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"},
              "counter_currency": {"type": "null"},
              "counter_amount": {"type": "null"},
              "is_correction": {"const": false}
            }
          },
          {
            "properties": {
              "type": {"const": "SPLIT"},
              "symbol": {"type": "string", "minLength": 1},
              "quantity": {"$ref": "#/components/schemas/Decimal"},
              "price": {"type": "null"},
              "fee": {"type": "null"},
              "amount": {"const": "0"},
              "counter_currency": {"type": "null"},
              "counter_amount": {"type": "null"},
              "is_correction": {"const": false}
            }
          },
          {
            "properties": {
              "type": {"const": "FX_EXCHANGE"},
              "symbol": {"type": "null"},
              "quantity": {"type": "null"},
              "price": {"type": "null"},
              "fee": {"type": "null"},
              "amount": {"type": "string", "pattern": "^-(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"},
              "counter_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
              "counter_amount": {"type": "string", "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$"},
              "is_correction": {"const": false}
            }
          },
          {
            "properties": {
              "type": {"const": "CASH_VOID"},
              "symbol": {"type": "null"},
              "quantity": {"type": "null"},
              "price": {"type": "null"},
              "fee": {"type": "null"},
              "counter_currency": {"type": "null"},
              "counter_amount": {"type": "null"},
              "is_correction": {"const": true}
            }
          },
          {
            "properties": {
              "type": {"enum": ["DEPOSIT", "WITHDRAWAL", "FEE", "TAX"]},
              "symbol": {"type": "null"},
              "quantity": {"type": "null"},
              "price": {"type": "null"},
              "fee": {"type": "null"},
              "counter_currency": {"type": "null"},
              "counter_amount": {"type": "null"},
              "is_correction": {"const": false}
            }
          }
        ]
      },
      "LedgerActivityPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "broker_freshness", "ledger_revision", "recorded_at", "events", "next_cursor"],
        "properties": {
          "source": {"const": "local_ledger"},
          "broker_freshness": {"const": "unverified", "description": "This read does not refresh a broker or prove current broker state."},
          "ledger_revision": {"type": "string", "pattern": "^rev_[0-9]{10}$"},
          "recorded_at": {"$ref": "#/components/schemas/LedgerActivityTimestamp"},
          "events": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/LedgerActivity"}},
          "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024}
        }
      },
      "LocalOrderView": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "symbol", "side", "order_type", "quantity", "limit_price", "filled_quantity", "currency", "status", "pending_action", "last_recorded_at"],
        "properties": {
          "mode": {"type": "string", "enum": ["synthetic", "paper"], "description": "Local execution mode, not a Kiwoom mock or production environment claim."},
          "symbol": {"type": "string", "pattern": "^[0-9]{6}$"},
          "side": {"type": "string", "enum": ["BUY", "SELL"]},
          "order_type": {"const": "LIMIT"},
          "quantity": {"type": "string", "pattern": "^[1-9][0-9]*$"},
          "limit_price": {"$ref": "#/components/schemas/Decimal", "description": "Canonical positive limit price."},
          "filled_quantity": {"$ref": "#/components/schemas/Decimal", "description": "Canonical non-negative quantity replayed from local events."},
          "currency": {"const": "KRW"},
          "status": {"type": "string", "enum": ["RECORDED", "READY", "RISK_REJECTED", "SUBMIT_UNKNOWN", "OPEN", "REJECTED", "PARTIALLY_FILLED", "CANCEL_UNKNOWN", "CANCELED", "FILLED"]},
          "pending_action": {"type": "string", "enum": ["SUBMIT", "CANCEL", "none"], "description": "Command still unresolved in the verified local replay, or none. This is not current broker state and contains no identifier."},
          "last_recorded_at": {"type": "string", "format": "date-time", "description": "Timestamp of the newest local append-only order event, not a broker observation time."}
        }
      },
      "LocalOrderLog": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "broker_freshness", "orders"],
        "properties": {
          "source": {"const": "local_order_log"},
          "broker_freshness": {"const": "unverified", "description": "This read does not refresh the broker or prove current broker state."},
          "orders": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/LocalOrderView"}
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "NormalizedTransaction": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "source_event_id", "account_id", "type", "occurred_at", "currency", "amount"],
        "properties": {
          "event_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "source_event_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "account_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "type": {
            "type": "string",
            "enum": ["BUY", "SELL", "DEPOSIT", "WITHDRAWAL", "DIVIDEND", "FEE", "TAX", "SPLIT", "CASH_VOID", "FX_EXCHANGE"]
          },
          "occurred_at": {
            "$ref": "#/components/schemas/OccurredAt"
          },
          "instrument_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "$ref": "#/components/schemas/Decimal"
          },
          "price": {
            "$ref": "#/components/schemas/Decimal"
          },
          "fee": {
            "$ref": "#/components/schemas/Decimal"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "amount": {
            "$ref": "#/components/schemas/Decimal",
            "description": "Signed net cash impact of the event, including fees."
          },
          "counter_currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Required only for FX_EXCHANGE; the distinct currency bought by the atomic exchange."
          },
          "counter_amount": {
            "$ref": "#/components/schemas/Decimal",
            "description": "Required only for FX_EXCHANGE; the positive exact cash amount bought. It does not imply a quoted or current exchange rate."
          },
          "corrects_source_event_id": {
            "$ref": "#/components/schemas/OpaqueId",
            "description": "Required only for CASH_VOID and identifies the same-account source event being exactly reversed."
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["type"],
              "properties": {
                "type": {
                  "const": "CASH_VOID"
                }
              }
            },
            "then": {
              "required": ["corrects_source_event_id"]
            },
            "else": {
              "not": {
                "required": ["corrects_source_event_id"]
              }
            }
          },
          {
            "if": {
              "required": ["type"],
              "properties": {
                "type": {
                  "const": "FX_EXCHANGE"
                }
              }
            },
            "then": {
              "required": ["counter_currency", "counter_amount"]
            },
            "else": {
              "not": {
                "anyOf": [
                  {"required": ["counter_currency"]},
                  {"required": ["counter_amount"]}
                ]
              }
            }
          }
        ]
      },
      "CorrectionTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_event_id", "type", "currency", "amount"],
        "properties": {
          "source_event_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "type": {
            "type": "string",
            "enum": ["DEPOSIT", "WITHDRAWAL", "DIVIDEND", "FEE", "TAX"]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "amount": {
            "$ref": "#/components/schemas/Decimal"
          }
        }
      },
      "PreviewRow": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row_number", "status"],
        "properties": {
          "row_number": {
            "type": "integer",
            "minimum": 2
          },
          "status": {
            "type": "string",
            "enum": ["error", "new", "duplicate", "unresolved"]
          },
          "transaction": {
            "$ref": "#/components/schemas/NormalizedTransaction"
          },
          "correction_target": {
            "$ref": "#/components/schemas/CorrectionTarget",
            "description": "Present for CASH_VOID rows so clients can disclose the preserved original without internal event identifiers."
          },
          "duplicate_of": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "errors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Error"
            }
          },
          "resolution": {
            "$ref": "#/components/schemas/PreviewResolution"
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["transaction"],
              "properties": {
                "transaction": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "type": {
                      "const": "CASH_VOID"
                    }
                  }
                }
              }
            },
            "then": {
              "required": ["correction_target"]
            },
            "else": {
              "not": {
                "required": ["correction_target"]
              }
            }
          }
        ]
      },
      "PreviewResolution": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "source_field", "source_value", "required_action", "candidate_ids"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["mapping", "account", "instrument"]
          },
          "source_field": {
            "type": "string",
            "minLength": 1
          },
          "source_value": {
            "type": "string"
          },
          "required_action": {
            "type": "string",
            "enum": ["select_column_mapping", "select_account", "select_instrument"]
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          }
        }
      },
      "PreviewTotals": {
        "type": "object",
        "additionalProperties": false,
        "required": ["total_rows", "new_rows", "duplicate_rows", "error_rows", "unresolved_rows"],
        "properties": {
          "total_rows": {
            "type": "integer",
            "minimum": 0
          },
          "new_rows": {
            "type": "integer",
            "minimum": 0
          },
          "duplicate_rows": {
            "type": "integer",
            "minimum": 0
          },
          "error_rows": {
            "type": "integer",
            "minimum": 0
          },
          "unresolved_rows": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ImportPreview": {
        "type": "object",
        "additionalProperties": false,
        "required": ["preview_id", "file_sha256", "schema_version", "mapping_version", "ledger_revision", "preview_fingerprint", "can_apply", "rows", "totals"],
        "properties": {
          "preview_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "schema_version": {
            "type": "string",
            "minLength": 1
          },
          "mapping_version": {
            "type": "string",
            "minLength": 1
          },
          "ledger_revision": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "preview_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 of compact sorted-key UTF-8 JSON containing file_sha256, schema_version, mapping_version, and ledger_revision. Apply must reject a changed binding."
          },
          "can_apply": {
            "type": "boolean",
            "description": "False when any row is error or unresolved; preview never mutates the ledger."
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PreviewRow"
            }
          },
          "totals": {
            "$ref": "#/components/schemas/PreviewTotals"
          }
        }
      },
      "ApplyImportRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["preview_id", "idempotency_key"],
        "properties": {
          "preview_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "idempotency_key": {
            "$ref": "#/components/schemas/OpaqueId"
          }
        }
      },
      "ApplyReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receipt_id", "preview_id", "idempotency_key", "file_sha256", "ledger_revision_before", "ledger_revision_after", "applied_rows", "skipped_duplicate_rows", "received_at", "recorded_at"],
        "properties": {
          "receipt_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "preview_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "idempotency_key": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "ledger_revision_before": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "ledger_revision_after": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "applied_rows": {
            "type": "integer",
            "minimum": 0
          },
          "skipped_duplicate_rows": {
            "type": "integer",
            "minimum": 0
          },
          "received_at": {
            "$ref": "#/components/schemas/ReceivedAt"
          },
          "recorded_at": {
            "$ref": "#/components/schemas/RecordedAt"
          }
        }
      },
      "Money": {
        "type": "object",
        "additionalProperties": false,
        "required": ["currency", "amount"],
        "properties": {
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "amount": {
            "$ref": "#/components/schemas/Decimal"
          }
        }
      },
      "Holding": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instrument_id", "symbol", "quantity", "cost_basis", "currency"],
        "properties": {
          "instrument_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "$ref": "#/components/schemas/Decimal"
          },
          "cost_basis": {
            "$ref": "#/components/schemas/Decimal",
            "description": "Remaining FIFO acquisition cost, including allocated buy fees."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        }
      },
      "SnapshotProvenance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_ids", "receipt_ids"],
        "properties": {
          "event_ids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          },
          "receipt_ids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          }
        }
      },
      "PortfolioSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": ["portfolio_id", "ledger_revision", "as_of", "recorded_at", "live_enabled", "valuation_status", "cash", "holdings", "realized_pnl", "provenance"],
        "properties": {
          "portfolio_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "ledger_revision": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "as_of": {
            "type": "string",
            "format": "date-time",
            "description": "Latest occurred_at included in this ledger snapshot."
          },
          "recorded_at": {
            "$ref": "#/components/schemas/RecordedAt"
          },
          "live_enabled": {
            "const": false
          },
          "valuation_status": {
            "const": "unavailable",
            "description": "No live price source is part of this slice."
          },
          "cash": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Money"
            }
          },
          "holdings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Holding"
            }
          },
          "realized_pnl": {
            "type": "array",
            "description": "FIFO realized profit/loss net of allocated buy fees and sell fees.",
            "items": {
              "$ref": "#/components/schemas/Money"
            }
          },
          "provenance": {
            "$ref": "#/components/schemas/SnapshotProvenance"
          }
        }
      }
    }
  }
}
