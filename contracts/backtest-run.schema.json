{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni-folio.local/contracts/backtest-run.v1.schema.json",
  "title": "Omni-Folio Backtest Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "manifest", "result", "disclaimer"],
  "properties": {
    "schema_version": {
      "const": "backtest-run.v1"
    },
    "run_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "status": {
      "const": "complete"
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "disclaimer": {
      "const": "Research fixture only; not investment advice."
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1
    },
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|-?(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9]))$",
      "description": "Canonical base-10 decimal string; JSON numbers are forbidden for financial values."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "parameters", "parameter_hash"],
      "properties": {
        "name": {
          "const": "buy_and_hold"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quantity", "liquidate_at_end"],
          "properties": {
            "quantity": {
              "$ref": "#/$defs/decimal"
            },
            "liquidate_at_end": {
              "const": true
            }
          }
        },
        "parameter_hash": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 of parameters encoded as sorted-key compact UTF-8 JSON."
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "version", "input_sha256", "bar_interval", "timezone"],
      "properties": {
        "dataset_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bar_interval": {
          "const": "1d"
        },
        "timezone": {
          "const": "UTC"
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starting_cash", "fee", "tax", "slippage_bps", "delay_bars", "max_participation", "signal_price", "fill_price"],
      "properties": {
        "starting_cash": {
          "$ref": "#/$defs/decimal"
        },
        "fee": {
          "$ref": "#/$defs/decimal",
          "description": "Flat fee charged per fill."
        },
        "tax": {
          "$ref": "#/$defs/decimal",
          "description": "Fraction of SELL notional charged as tax."
        },
        "slippage_bps": {
          "$ref": "#/$defs/decimal",
          "description": "One-sided adverse slippage from the eligible bar open."
        },
        "delay_bars": {
          "$ref": "#/$defs/decimal",
          "description": "Whole bars between signal observation and fill eligibility."
        },
        "max_participation": {
          "$ref": "#/$defs/decimal",
          "description": "Maximum filled quantity as a fraction of eligible bar volume."
        },
        "signal_price": {
          "const": "bar_close"
        },
        "fill_price": {
          "const": "next_eligible_bar_open"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "data", "engine", "execution", "started_at", "finished_at"],
      "properties": {
        "strategy": {
          "$ref": "#/$defs/strategy"
        },
        "data": {
          "$ref": "#/$defs/data"
        },
        "engine": {
          "$ref": "#/$defs/engine"
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "finished_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fill_id", "bar_at", "quantity", "price", "notional", "fee", "tax", "fill_state"],
      "properties": {
        "fill_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "bar_at": {
          "$ref": "#/$defs/timestamp"
        },
        "quantity": {
          "$ref": "#/$defs/decimal"
        },
        "price": {
          "$ref": "#/$defs/decimal"
        },
        "notional": {
          "$ref": "#/$defs/decimal"
        },
        "fee": {
          "$ref": "#/$defs/decimal"
        },
        "tax": {
          "$ref": "#/$defs/decimal"
        },
        "fill_state": {
          "type": "string",
          "enum": ["partial", "complete"]
        }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id", "symbol", "side", "requested_quantity", "signal_at", "first_eligible_at", "first_fill_at", "fills"],
      "properties": {
        "order_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "type": "string",
          "enum": ["BUY", "SELL"]
        },
        "requested_quantity": {
          "$ref": "#/$defs/decimal"
        },
        "signal_at": {
          "$ref": "#/$defs/timestamp"
        },
        "first_eligible_at": {
          "$ref": "#/$defs/timestamp"
        },
        "first_fill_at": {
          "$ref": "#/$defs/timestamp"
        },
        "fills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fill"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starting_cash", "ending_cash", "ending_equity", "total_return", "realized_pnl", "unrealized_pnl", "fees", "taxes", "slippage_cost", "turnover", "max_drawdown", "partial_fill_count", "lookahead_violations"],
      "properties": {
        "starting_cash": {
          "$ref": "#/$defs/decimal"
        },
        "ending_cash": {
          "$ref": "#/$defs/decimal"
        },
        "ending_equity": {
          "$ref": "#/$defs/decimal"
        },
        "total_return": {
          "$ref": "#/$defs/decimal"
        },
        "realized_pnl": {
          "$ref": "#/$defs/decimal"
        },
        "unrealized_pnl": {
          "$ref": "#/$defs/decimal"
        },
        "fees": {
          "$ref": "#/$defs/decimal"
        },
        "taxes": {
          "$ref": "#/$defs/decimal"
        },
        "slippage_cost": {
          "$ref": "#/$defs/decimal"
        },
        "turnover": {
          "$ref": "#/$defs/decimal"
        },
        "max_drawdown": {
          "$ref": "#/$defs/decimal"
        },
        "partial_fill_count": {
          "$ref": "#/$defs/decimal"
        },
        "lookahead_violations": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "metrics", "orders", "positions"],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "orders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/order"
          }
        },
        "positions": {
          "type": "array",
          "maxItems": 0,
          "description": "Empty because the fixture liquidates on its final eligible bar."
        }
      }
    }
  }
}
